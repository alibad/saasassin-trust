{
  "name": "saasassin-trust",
  "version": "0.1.0",
  "private": true,
  "description": "SaaSassin Trust: a free, open-source Vanta alternative.",
  "license": "AGPL-3.0-only",
  "homepage": "https://trust.saasassin.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibad/saasassin-trust.git"
  },
  "bugs": {
    "url": "https://github.com/alibad/saasassin-trust/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.mjs",
    "test:rules": "node scripts/test-firestore-rules.mjs",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-saasassin \"pnpm exec vitest run --config vitest.emulator.config.mjs\"",
    "firebase:emulators": "firebase emulators:start --only firestore"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "posthog-js": "^1.414.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^15.26.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.14.0"
